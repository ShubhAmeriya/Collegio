<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="College Events"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/eventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event Title" />

        <EditText
            android:id="@+id/eventDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event Date"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/eventVenue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Venue"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/createEventButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Event"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/viewEventButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Event"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/registerEventButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register for Event"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/eventOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No event created yet."
            android:textSize="18sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>